# =============================================================================
# Copy to .env.local and fill in. Only the REQUIRED block is needed to develop;
# everything else degrades to a no-op when left blank.
#
# VITE_* values are inlined into the browser bundle — never put a secret there.
# Values marked [convex] live in the Convex deployment, not this file:
#   npx convex env set NAME value
# =============================================================================

# --- REQUIRED -----------------------------------------------------------------

# Convex. Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# HTTP actions host (…convex.site). Used for the Stripe webhook URL.
VITE_CONVEX_SITE_URL=

# Clerk — https://dashboard.clerk.com → API keys
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# [convex] Issuer URL of the Clerk JWT template named "convex".
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev


# --- SITE ---------------------------------------------------------------------

# Canonical origin. Drives canonical tags, OG URLs and the generated sitemap.
# Leave unset for local development; set it in CI before building for production.
VITE_SITE_URL=

# [convex] Same origin, used to build Stripe success/cancel/return URLs.
# npx convex env set SITE_URL https://example.com


# --- BILLING (optional — Stripe) ----------------------------------------------
# All of these are [convex]; the browser never sees a Stripe key or price id.
#
# npx convex env set STRIPE_SECRET_KEY sk_test_...
# npx convex env set STRIPE_WEBHOOK_SECRET whsec_...
# npx convex env set STRIPE_PRICE_PRO_MONTHLY price_...
# npx convex env set STRIPE_PRICE_PRO_YEARLY price_...
# npx convex env set STRIPE_PRICE_SCALE_MONTHLY price_...
# npx convex env set STRIPE_PRICE_SCALE_YEARLY price_...
#
# Webhook endpoint: https://<deployment>.convex.site/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted


# --- EMAIL (optional — Resend) ------------------------------------------------
# [convex]. Without these the contact form still stores messages in Convex.
#
# npx convex env set RESEND_API_KEY re_...
# npx convex env set CONTACT_TO_EMAIL you@example.com
# npx convex env set CONTACT_FROM_EMAIL noreply@example.com


# --- OBSERVABILITY (optional) -------------------------------------------------

# Sentry — leave blank to disable error reporting entirely.
VITE_SENTRY_DSN=
# Only needed to upload source maps in CI.
SENTRY_AUTH_TOKEN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=

# PostHog — leave blank to disable analytics.
VITE_POSTHOG_KEY=
# Override for EU cloud or a self-hosted instance.
# VITE_POSTHOG_HOST=https://eu.i.posthog.com


# --- FEEDBACK & DOCS (optional — Featurebase) ---------------------------------
# Set the org to derive all three URLs, or set URLs individually. Footer links
# are hidden when these are unset.
VITE_FEATUREBASE_ORG=
VITE_FEATUREBASE_FEEDBACK_URL=
VITE_FEATUREBASE_CHANGELOG_URL=
VITE_FEATUREBASE_HELP_URL=
