{
  "name": "townhall",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#convex/*": "./convex/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- vite dev --port 43125 --host 127.0.0.1",
    "dev:convex": "convex dev",
    "dev:all": "npm-run-all --parallel dev dev:convex",
    "build": "dotenv -e .env.local -- vite build",
    "preview": "dotenv -e .env.local -- vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check . && pnpm run lint && pnpm run typecheck",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.21",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "0.1.0",
    "@mdx-js/react": "^3.1.1",
    "@posthog/react": "^1.7.0",
    "@sentry/tanstackstart-react": "^10.67.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "posthog-js": "^1.358.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@sentry/cli",
      "sharp",
      "workerd"
    ]
  }
}
